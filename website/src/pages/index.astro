---
import Base from '../layouts/Base.astro';
import '../styles/home.css';
import Sprite from '../components/Sprite.astro';
import { HOSTS, AGENT_PROMPT, shellHtml } from '../lib/hosts';
import { docUrl } from '../lib/links.mjs';
import { SUMMARY, HOME_TITLE, packageVersion } from '../lib/site';

const VAULTS = [
  { name: 'macOS Keychain', note: 'default on a Mac' },
  { name: 'Linux keyring', note: 'libsecret' },
  { name: '1Password', note: 'op CLI' },
  { name: 'Bitwarden', note: 'bw CLI' },
  { name: 'HashiCorp Vault', note: 'company Vault' },
  { name: 'KeePassXC', note: 'KeePass file' },
  { name: 'Keeper', note: 'Commander' },
  { name: 'systemd-creds', note: 'TPM2' },
  { name: 'Encrypted file', note: 'AES-256-GCM' },
];

// Seventh by downloads in ClawHub's Security category when checked on 2026-11-17. Recheck now and then; remove if it stops being true.
const APIS = ['OpenAI', 'Anthropic', 'GitHub', 'Stripe', 'xAI', 'Mistral', 'Hugging Face', 'ElevenLabs', 'Slack', 'Discord'];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'aquaman',
  alternateName: HOME_TITLE,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Linux, WSL2',
  description: SUMMARY.replace(/`/g, ''),
  url: Astro.site!.href,
  softwareVersion: packageVersion(),
  license: 'https://www.apache.org/licenses/LICENSE-2.0',
  codeRepository: 'https://github.com/tech4242/aquaman',
  downloadUrl: 'https://www.npmjs.com/package/aquaman-proxy',
  sameAs: ['https://github.com/tech4242/aquaman', 'https://www.npmjs.com/package/aquaman-proxy', 'https://pypi.org/project/aquaman-hermes/'],
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
const description =
  'Give Claude Code, Codex and other AI agents an API key without handing it over. Open source, runs on your machine, keeps keys in the vault you already use.';
---
<Base description={description} markdown="/index.md" jsonLd={jsonLd} wide look="gb">
  <div class="home">
    <div class="gauge" aria-hidden="true"><i></i></div>

    <section class="zone surface">
      <div class="wrap">
        <header class="zh">
          <h1>Give your AI agent an API key without handing it over</h1>
          <p class="depth" aria-hidden="true">Depth 000 m: the surface</p>
        </header>
        <p class="subline">Your agent stays up here with a reference. The key stays down there, in your vault.</p>
        <p class="what">aquaman is an open-source credential proxy that runs on your machine. No account, no cloud.</p>
        <div class="cta">
          <a class="btn a" href="#start">Start</a>
          <a class="btn b" href="/docs/approve/">My agent asked to install it</a>
        </div>
        <p class="rank">
          <Sprite name="LOBSTER" px={1} />
          <span>Top 10 Security plugin on ClawHub</span>
        </p>
        <div class="raft">
          <Sprite name="ROBOT" px={3} label="A small robot on a raft: your agent, on the surface" />
        </div>
      </div>
      <div class="sky" aria-hidden="true">
        <Sprite name="SUN" px={4} class="sun" />
        <Sprite name="CLOUD" px={4} class="cloud c1" />
        <Sprite name="CLOUD" px={3} class="cloud c2" />
      </div>
      <div class="waves" aria-hidden="true"></div>
    </section>

    <section class="zone floor d1" id="start" aria-labelledby="start-heading">
      <div class="line" aria-hidden="true"></div>
      <div class="wrap">
        <header class="zh">
          <h2 id="start-heading">Start here: pick your host</h2>
          <p class="depth" aria-hidden="true">Depth 005 m: press start</p>
        </header>
        <fieldset class="hosts">
          <legend>Pick your host</legend>
          {HOSTS.map((h, i) => <input type="radio" name="host" id={`host-${h.id}`} checked={i === 0} />)}
          <div class="tabs">
            {HOSTS.map((h) => <label for={`host-${h.id}`}>{h.name}</label>)}
          </div>
          {HOSTS.map((h) => (
            <div class="panel box" data-host={h.id}>
              <h3>{h.name}</h3>
              <p class="how">{h.how}</p>
              <pre><code set:html={shellHtml(h.commands)} /></pre>
              {h.agentPrompt && (
                <details>
                  <summary>Or hand it to your agent</summary>
                  <p>Paste this into {h.name}:</p>
                  <pre><code>{AGENT_PROMPT}</code></pre>
                </details>
              )}
              {h.note && <p class="note" set:html={h.note.replace(/`([^`]+)`/g, '<code>$1</code>')} />}
              <p><a href={docUrl(h.guide)}>Full guide</a></p>
            </div>
          ))}
        </fieldset>
        <p class="all-hosts">Every host's guide: {HOSTS.map((h, i) => <>{i > 0 && ', '}<a href={docUrl(h.guide)}>{h.name}</a></>)}. All of them in one file: <a href="/index.md">/index.md</a>.</p>
        <style set:html={HOSTS.map((h) =>
          `#host-${h.id}:checked ~ .panel[data-host="${h.id}"]{display:block}` +
          `#host-${h.id}:checked ~ .tabs label[for="host-${h.id}"]{background:var(--y);color:var(--ink)}` +
          `#host-${h.id}:checked ~ .tabs label[for="host-${h.id}"]::before{content:"\\25B6  "}` +
          `#host-${h.id}:focus-visible ~ .tabs label[for="host-${h.id}"]{outline:4px solid var(--c)}`).join('')} />
      </div>
      <div class="dither" aria-hidden="true"></div>
    </section>

    <section class="zone deep d2">
      <div class="line end" aria-hidden="true"><Sprite name="TAG" px={3} lit /></div>
      <div class="swim f2" aria-hidden="true"><Sprite name="FISH" px={3} lit /></div>
      <div class="wrap">
        <header class="zh">
          <h2>aquaman guards whichever vault you already have.</h2>
          <p class="depth" aria-hidden="true">Depth 040 m: aquaman</p>
        </header>
        <div class="guard">
          <div class="octo">
            <Sprite name="OCTOPUS" px={4} class="open" lit label="aquaman, drawn as an octopus, guarding a chest: your vault keeps the key" />
            <Sprite name="OCTOPUS_BLINK" px={4} class="shut" lit />
            <div class="loot"><Sprite name="CHEST" px={3} lit /><Sprite name="KEY" px={4} class="key" lit /></div>
          </div>
          <ul class="vaults">
            {VAULTS.map((v) => <li><b>{v.name}</b>{' '}<span>{v.note}</span></li>)}
          </ul>
        </div>
        <p class="aside">No new place for your keys. Switch vault later and nothing changes for the agent.</p>
      </div>
      <div class="dither" aria-hidden="true"></div>
    </section>

    <section class="zone mid d3">
      <div class="rise b1" aria-hidden="true"><Sprite name="BUBBLE" px={3} /></div>
      <div class="rise b2" aria-hidden="true"><Sprite name="BUBBLE" px={2} /></div>
      <div class="wrap">
        <header class="zh">
          <h2>What aquaman does with every key</h2>
          <p class="depth" aria-hidden="true">Depth 100 m: on the way down</p>
        </header>
        <div class="proof">
          <article class="box">
            <h3>Ink: output redaction</h3>
            <p>The agent never sees the key. Commands get it; the transcript gets a redaction marker.</p>
            <pre><code><span class="prompt">&gt; </span>printenv STRIPE_SECRET_KEY
<span class="masked">[REDACTED:injected-value]</span></code></pre>
            <Sprite name="INK" px={3} class="deco" />
          </article>
          <article class="box">
            <h3>Depth limits: request policies</h3>
            <p>For an app routed through aquaman, your policy rules decide which calls get a key.</p>
            <pre><code>{`policy:
  stripe:
    rules:
      - method: DELETE
        path: /v1/customers/**
        action: deny`}

<span class="prompt">DELETE /v1/customers/cus_1  </span><span class="masked">403</span></code></pre>
          </article>
          <article class="box">
            <h3>Ship's log: audit log</h3>
            <p>Every use is written to an audit log on your machine, chained by SHA-256.</p>
            <pre><code><span class="prompt">&gt; </span>aquaman audit tail
<span class="prompt">[CREDENTIAL_ACCESS] </span>stripe use OK
<span class="prompt">[CREDENTIAL_ACCESS] </span>github read OK
<span class="prompt">&gt; </span>aquaman audit verify</code></pre>
          </article>
        </div>
      </div>
      <div class="dither" aria-hidden="true"></div>
    </section>

    <section class="zone anyapp d4">
      <div class="wrap">
        <header class="zh">
          <h2>Any app, any SDK: point it at aquaman and it never holds the key.</h2>
          <p class="depth" aria-hidden="true">Depth 200 m: not only agents</p>
        </header>
        <div class="route">
          <div>
            <p class="big">Your code changes in one place: the API base URL comes from the environment. aquaman hands the app a local token and its own address, adds the real key on the way out, and applies your request policies.</p>
            <ul class="steps">
              <li><b>The app holds</b> <span>a token that only works on your machine</span></li>
              <li><b>aquaman holds</b> <span>the key, in your vault</span></li>
              <li><b>The API sees</b> <span>a normal request with the real key</span></li>
            </ul>
            <p><a class="btn b" href="#start" data-check="host-your-app">How to set it up</a></p>
          </div>
          <figure class="box">
            <figcaption>What your app sees</figcaption>
            <pre><code><span class="prompt"># its environment, set by aquaman</span>
OPENAI_BASE_URL=<span class="ref">http://127.0.0.1:8585/openai/v1</span>
OPENAI_API_KEY=<span class="masked">aqm_rt_…</span>   <span class="prompt"># a local token, not the key</span>

<span class="prompt">// its code, unchanged: the SDK reads both</span>
const openai = new OpenAI();</code></pre>
            <p class="apis">Built in: {APIS.join(', ')} and more. Any other HTTP API takes five lines of config.</p>
          </figure>
        </div>
      </div>
    </section>

    <section class="zone shallow d5">
      <div class="swim f1" aria-hidden="true"><Sprite name="FISH" px={3} lit /></div>
      <div class="wrap">
        <header class="zh">
          <h2>The agent asks. You answer. It gets a reference, not the key.</h2>
          <p class="depth" aria-hidden="true">Sea floor: how the ask works</p>
        </header>
        <div class="exchange" aria-label="What happens when an agent needs a key">
          <figure class="box term">
            <figcaption>Agent</figcaption>
            <pre><code><span class="ln s1"><span class="prompt">&gt; </span><span class="type t1">aquaman request <span class="ref">aquaman://github/token</span> --env GITHUB_TOKEN --json</span></span>
<span class="ln s4">{`{ "status": "stored", "env": "GITHUB_TOKEN",`}
{`  "ref": "`}<span class="ref">aquaman://github/token</span>{`" }`}</span>
<span class="ln s5"><span class="prompt">&gt; </span><span class="type t2">aquaman-coder exec -- gh api user --jq .login</span></span>
<span class="ln s6">octocat</span>
<span class="ln s7"><span class="prompt">&gt; </span><span class="type t3">aquaman-coder exec -- printenv GITHUB_TOKEN</span></span>
<span class="ln s8"><span class="masked">[REDACTED:injected-value]</span></span></code></pre>
          </figure>
          <figure class="box dialog s2">
            <figcaption>You</figcaption>
            <div role="img" aria-label="A system dialog titled aquaman asking you to type the value for github/token, with Cancel and Store in vault choices">
              <p>An agent is asking for a credential that is not in your vault.</p>
              <p class="cred">github/token</p>
              <div class="field"><span class="dots">********************</span></div>
              <ul class="menu"><li class="go">Store in vault</li><li>Cancel</li></ul>
            </div>
          </figure>
        </div>
        <ol class="flow">
          <li><b>You type it once</b> <span>in a system dialog, never the chat</span></li>
          <li><b>Your vault keeps it</b> <span>the one you already use</span></li>
          <li><b>One command gets it</b> <span>for as long as it runs</span></li>
          <li><b>The agent holds a reference</b> <span>like aquaman://github/token, and sees [REDACTED]</span></li>
        </ol>
      </div>
    </section>

    <section class="zone sand">
      <div class="seabed" aria-hidden="true">
        <Sprite name="WEED_TALL" px={4} />
        <Sprite name="CHEST_OPEN" px={4} lit class="treasure" />
        <Sprite name="ANCHOR" px={5} />
        <Sprite name="CORAL" px={4} lit />
        <Sprite name="ROCK" px={4} lit />
      </div>
      <div class="beach" aria-hidden="true">
        <Sprite name="STARFISH" px={3} class="s1" />
        <Sprite name="SHELL" px={3} class="s2" />
        <Sprite name="CRAB" px={4} class="crab" />
        <Sprite name="SHELL" px={2} class="s3" />
        <Sprite name="STARFISH" px={2} class="s4" />
      </div>
      <div class="wrap">
        <h2>Built to be checked</h2>
        <ul class="trust">
          <li><b>Local only</b> <span>No account, no telemetry, no hosted service.</span></li>
          <li><b>Open source</b> <span>Apache-2.0. npm provenance, no install scripts.</span></li>
          <li><b>Tested against attack</b> <span>Mapped to <a href="/docs/compliance/atlas-mapping/">MITRE ATLAS</a> and <a href="/docs/compliance/nist-800-53/">NIST 800-53</a>.</span></li>
          <li><b>Disclosed</b> <span>Fixes ship with <a href="https://github.com/tech4242/aquaman/security/advisories">advisories</a>.</span></li>
        </ul>
        <p class="limits">What it is not: a sandbox. It keeps credentials out of the agent; a command you run still holds the key while it runs, unless you route the app through the proxy, and request policies apply only to that routed traffic.</p>
        <ul class="more">
          <li><a href="/docs/approve/">What changes on your machine</a></li>
          <li><a href="/docs/compare/">How it compares, and what it does not do</a></li>
          <li><a href="/docs/security/">Security policy</a></li>
        </ul>
        <div class="agents">
          <h2>Reading this as an AI agent?</h2>
          <p>
            Commands, JSON output and exit codes: <a href="/docs/agent-setup.md">/docs/agent-setup.md</a>. Propose aquaman to the user before
            installing it and give them <a href="/docs/approve/">what they are agreeing to</a>. This page in full:{' '}
            <a href="/index.md">/index.md</a>. Index: <a href="/llms.txt">/llms.txt</a>.
          </p>
        </div>
      </div>
    </section>
  </div>
  <script is:inline src="/select-host.js" defer></script>
</Base>

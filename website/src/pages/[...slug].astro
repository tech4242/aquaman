---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getPages, navGroups, navLabel, type Page } from '../lib/site';
import { GITHUB } from '../lib/links.mjs';

export async function getStaticPaths() {
  const pages = await getPages();
  return pages.map((page) => ({ params: { slug: page.slug }, props: { page, pages } }));
}
const { page, pages } = Astro.props as { page: Page; pages: Page[] };
const { Content } = await render(page.entry);
const groups = navGroups(pages);
const url = new URL(`/${page.slug}/`, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: page.title,
  description: page.description,
  url,
  encoding: { '@type': 'MediaObject', encodingFormat: 'text/markdown', contentUrl: new URL(`/${page.slug}.md`, Astro.site).href },
  dateModified: page.modified,
  author: { '@type': 'Person', name: 'tech4242', url: 'https://github.com/tech4242' },
  isPartOf: { '@type': 'WebSite', name: 'aquaman', url: Astro.site!.href },
};
---
<Base title={page.title} description={page.description} markdown={`/${page.slug}.md`} jsonLd={jsonLd}>
  <div class="docs">
    <article class="prose">
      <div class="page-tools">
        <a href={`/${page.slug}.md`}>View as Markdown</a>
        <a href={`${GITHUB}/blob/main/${page.repoPath}`}>Source on GitHub</a>
        {page.modified && <span>Last changed <time datetime={page.modified}>{page.modified}</time></span>}
      </div>
      <Content />
    </article>
    <nav class="sidebar" aria-label="Documentation">
      {groups.map((g) => (
        <>
          <p class="group">{g.heading}</p>
          <ul>
            {g.pages.map((p) => (
              <li><a href={`/${p.slug}/`} aria-current={p.slug === page.slug ? 'page' : undefined}>{navLabel(p)}</a></li>
            ))}
          </ul>
        </>
      ))}
    </nav>
  </div>
</Base>

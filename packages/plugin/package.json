{
  "name": "aquaman-plugin",
  "version": "0.22.1",
  "description": "aquaman: credential broker for AI agents (OpenClaw). Keeps provider API keys out of the gateway process; injects them from your own vault through a local proxy.",
  "type": "module",
  "scripts": {
    "build": "tsc -b && cp secrets-resolver.mjs dist/secrets-resolver.mjs",
    "prepublishOnly": "npm run clean && npm run build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.6.5",
      "minGatewayVersion": "2026.6.5"
    },
    "build": {
      "openclawVersion": "2026.7.33",
      "pluginSdkVersion": "2026.7.33"
    }
  },
  "keywords": [
    "aquaman",
    "openclaw",
    "openclaw-plugin",
    "plugin",
    "security",
    "credentials",
    "vault",
    "1password",
    "api-key",
    "secrets",
    "keychain",
    "bitwarden",
    "credential-isolation",
    "token-security",
    "api-protection",
    "ai-agents",
    "credential-broker",
    "credential-proxy",
    "agent-security",
    "secrets-management",
    "api-keys",
    "hashicorp-vault",
    "keepassxc",
    "agent"
  ],
  "author": "tech4242",
  "license": "Apache-2.0",
  "dependencies": {
    "@sinclair/typebox": "0.34.52",
    "aquaman-proxy": "0.22.1",
    "undici": "7.30.2"
  },
  "peerDependencies": {
    "openclaw": ">=2026.6.5"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tech4242/aquaman.git",
    "directory": "packages/plugin"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "homepage": "https://aquaman.sh",
  "bugs": {
    "url": "https://github.com/tech4242/aquaman/issues"
  }
}

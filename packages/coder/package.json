{
  "name": "aquaman-coder",
  "version": "0.18.0",
  "description": "aquaman: credential proxy for AI agents (Claude Code, Codex). Keeps API keys, tokens and .env secrets out of your coding agent's context and transcripts; injects them per command from your own vault.",
  "type": "module",
  "bin": {
    "aquaman-coder": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "prepublishOnly": "npm run clean && npm run build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "keywords": [
    "aquaman",
    "aquaman-coder",
    "claude-code",
    "codex",
    "credentials",
    "vault",
    "secrets",
    "dotenv",
    "secret-management",
    "credential-isolation",
    "coding-agent",
    "ai-agent",
    "1password",
    "keychain",
    "bitwarden",
    "ai-agents",
    "credential-proxy",
    "agent-security",
    "secrets-management",
    "api-keys",
    "hashicorp-vault",
    "keepassxc",
    "claude",
    "agent",
    "env"
  ],
  "author": "tech4242",
  "license": "MIT",
  "dependencies": {
    "aquaman-proxy": "0.18.0",
    "commander": "^11.0.0",
    "smol-toml": "1.9.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.3.0"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tech4242/aquaman.git",
    "directory": "packages/coder"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "homepage": "https://github.com/tech4242/aquaman/tree/main/packages/coder#readme",
  "bugs": {
    "url": "https://github.com/tech4242/aquaman/issues"
  }
}

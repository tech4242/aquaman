{
  "name": "aquaman-proxy",
  "version": "0.22.0",
  "description": "aquaman: credential broker for AI agents (core). No account, bring your own vault, runs locally. API keys stay in Keychain, 1Password, Bitwarden or HashiCorp Vault and are injected at request time, so the agent never holds them.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "aquaman": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./daemon": {
      "types": "./dist/daemon.d.ts",
      "import": "./dist/daemon.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "prepublishOnly": "npm run clean && npm run build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli/index.js",
    "dev": "tsx watch src/cli/index.ts"
  },
  "keywords": [
    "aquaman",
    "openclaw",
    "security",
    "credentials",
    "vault",
    "1password",
    "api-key",
    "secrets",
    "keychain",
    "bitwarden",
    "proxy",
    "api-protection",
    "ai-agents",
    "credential-broker",
    "credential-proxy",
    "agent-security",
    "secrets-management",
    "claude-code",
    "codex",
    "dotenv",
    "api-keys",
    "hashicorp-vault",
    "keepassxc",
    "coding-agent",
    "claude",
    "agent",
    "env"
  ],
  "author": "tech4242",
  "license": "Apache-2.0",
  "dependencies": {
    "commander": "^12.0.0",
    "yaml": "^2.9.1"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  },
  "peerDependencies": {
    "argon2": "^0.45.1",
    "kdbxweb": "^2.1.1",
    "@grpc/grpc-js": "^1.14.5",
    "@grpc/proto-loader": "^0.8.1"
  },
  "peerDependenciesMeta": {
    "argon2": {
      "optional": true
    },
    "kdbxweb": {
      "optional": true
    },
    "@grpc/grpc-js": {
      "optional": true
    },
    "@grpc/proto-loader": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^5.3.0"
  },
  "files": [
    "dist",
    "proto",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tech4242/aquaman.git",
    "directory": "packages/proxy"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "homepage": "https://aquaman.sh",
  "bugs": {
    "url": "https://github.com/tech4242/aquaman/issues"
  }
}

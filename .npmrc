# Keep in lockstep with CI (`npm ci --legacy-peer-deps`). Without it, npm follows
# the optional peer edges (aquaman-plugin -> openclaw, aquaman-proxy -> kdbxweb/argon2)
# on any lockfile regeneration -- including Dependabot's -- and marks those subtrees
# devOptional instead of dev, so `npm audit --omit=dev` audits the wrong tree and
# test/unit/packaging-posture.test.ts fails. Root-only: never shipped in a tarball.
legacy-peer-deps=true

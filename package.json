{
  "name": "aquaman",
  "version": "0.18.2",
  "private": true,
  "description": "aquaman: credential proxy for AI agents. No account, bring your own vault, runs locally.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w aquaman-proxy -w aquaman-plugin -w aquaman-coder",
    "build:proxy": "npm run build -w aquaman-proxy",
    "build:plugin": "npm run build -w aquaman-plugin",
    "build:coder": "npm run build -w aquaman-coder",
    "clean": "npm run clean --workspaces && rm -rf dist packages/*/tsconfig.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "node scripts/coverage.mjs",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "oxlint src test packages --ignore-pattern node_modules --ignore-pattern dist --ignore-pattern coverage",
    "lint:fix": "oxlint src test packages --ignore-pattern node_modules --ignore-pattern dist --ignore-pattern coverage --fix",
    "typecheck": "tsc -b packages/proxy packages/plugin packages/coder",
    "start": "node packages/proxy/dist/cli/index.js",
    "dev": "tsx watch packages/proxy/src/cli/index.ts"
  },
  "keywords": [
    "aquaman",
    "openclaw",
    "security",
    "credentials",
    "vault",
    "1password",
    "api-key",
    "secrets",
    "keychain",
    "bitwarden",
    "ai-agent",
    "api-protection",
    "claude-code",
    "codex",
    "coding-agent",
    "credential-proxy",
    "ai-agents",
    "secrets-management",
    "claude",
    "agent",
    "env"
  ],
  "author": "tech4242",
  "license": "Apache-2.0",
  "devDependencies": {
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.8.1",
    "@types/node": "^20.19.43",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^4.1.12",
    "ajv": "^8.17.0",
    "argon2": "^0.45.2",
    "c8": "^10.1.3",
    "kdbxweb": "^2.1.1",
    "oxlint": "^0.18.1",
    "tsx": "^4.23.15",
    "typescript": "^5.3.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "kdbxweb": {
      "@xmldom/xmldom": "0.8.15",
      "fflate": "^0.7.5"
    },
    "ajv": {
      "fast-uri": "^4.1.4"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
